--- patches/orig/prismarine-physics.lib.aabb.js	2026-09-18 18:32:03.973409130 +0000
+++ node_modules/prismarine-physics/lib/aabb.js	2026-09-18 18:32:03.990409459 +0000
@@ -1,3 +1,12 @@
+// PATCHED (bots/patches/03-*): vanilla clamps movement against a face it is up to
+// 1e-7 *behind* (Shapes.collide / VoxelShape.collideX use a -1.0E-7 tolerance).
+// Without that tolerance a player whose AABB overlaps a block by a single ULP
+// (which happens constantly, because (blockMin - halfWidth) + halfWidth is not
+// exactly blockMin in doubles) is treated as "already inside", the clamp is
+// skipped and the client walks ~0.02 blocks INTO the block. The server rejects
+// that move and teleports back -> 20 Hz rubber-band loop, bot frozen.
+const COLLIDE_EPS = 1e-7
+
 class AABB {
   constructor (x0, y0, z0, x1, y1, z1) {
     this.minX = x0
@@ -66,9 +75,9 @@
 
   computeOffsetX (other, offsetX) {
     if (other.maxY > this.minY && other.minY < this.maxY && other.maxZ > this.minZ && other.minZ < this.maxZ) {
-      if (offsetX > 0.0 && other.maxX <= this.minX) {
+      if (offsetX > 0.0 && other.maxX <= this.minX + COLLIDE_EPS) {
         offsetX = Math.min(this.minX - other.maxX, offsetX)
-      } else if (offsetX < 0.0 && other.minX >= this.maxX) {
+      } else if (offsetX < 0.0 && other.minX >= this.maxX - COLLIDE_EPS) {
         offsetX = Math.max(this.maxX - other.minX, offsetX)
       }
     }
@@ -77,9 +86,9 @@
 
   computeOffsetY (other, offsetY) {
     if (other.maxX > this.minX && other.minX < this.maxX && other.maxZ > this.minZ && other.minZ < this.maxZ) {
-      if (offsetY > 0.0 && other.maxY <= this.minY) {
+      if (offsetY > 0.0 && other.maxY <= this.minY + COLLIDE_EPS) {
         offsetY = Math.min(this.minY - other.maxY, offsetY)
-      } else if (offsetY < 0.0 && other.minY >= this.maxY) {
+      } else if (offsetY < 0.0 && other.minY >= this.maxY - COLLIDE_EPS) {
         offsetY = Math.max(this.maxY - other.minY, offsetY)
       }
     }
@@ -88,9 +97,9 @@
 
   computeOffsetZ (other, offsetZ) {
     if (other.maxX > this.minX && other.minX < this.maxX && other.maxY > this.minY && other.minY < this.maxY) {
-      if (offsetZ > 0.0 && other.maxZ <= this.minZ) {
+      if (offsetZ > 0.0 && other.maxZ <= this.minZ + COLLIDE_EPS) {
         offsetZ = Math.min(this.minZ - other.maxZ, offsetZ)
-      } else if (offsetZ < 0.0 && other.minZ >= this.maxZ) {
+      } else if (offsetZ < 0.0 && other.minZ >= this.maxZ - COLLIDE_EPS) {
         offsetZ = Math.max(this.maxZ - other.minZ, offsetZ)
       }
     }
